{
  "name": "esi-pro-by",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "verify": "npm run check && npm run build",
    "preview": "wrangler pages dev -c wrangler.jsonc -c email-worker/wrangler.jsonc",
    "deploy:email": "wrangler deploy -c email-worker/wrangler.jsonc",
    "deploy:pages": "wrangler pages deploy dist --project-name=esi-pro-by",
    "deploy": "npm run verify && npm run deploy:pages",
    "astro": "astro"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "astro": "^7.2.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260825.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.125.0"
  }
}
