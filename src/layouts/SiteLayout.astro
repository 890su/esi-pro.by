---
import '../styles/global.css';
import '../styles/pages.css';
import '../styles/analytics.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { localeMeta, locales, localizePath, messages, type Locale } from '../data/i18n';
import { company } from '../data/company';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  currentSlug: string;
  image?: string;
  schemaType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage';
  additionalSchema?: Record<string, unknown>;
  breadcrumbParents?: { label: string; path: string }[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
  imageWidth?: number;
  imageHeight?: number;
}

const {
  locale,
  title,
  description,
  currentSlug,
  image = '/images/slider-1.png',
  schemaType = 'WebPage',
  additionalSchema,
  breadcrumbParents = [],
  noindex = false,
  ogType = 'website',
  imageWidth = 1920,
  imageHeight = 1080,
} = Astro.props;
const copy = messages[locale];
const site = Astro.site ?? new URL(import.meta.env.PUBLIC_SITE_URL || 'https://esi-pro.by');
const canonicalUrl = new URL(localizePath(locale, currentSlug), site);
const imageUrl = new URL(image, site);
const fullTitle = currentSlug ? `${title} — ESIpro` : title;
const organizationId = new URL('/#organization', site).toString();
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: company.legalName,
    alternateName: company.brand,
    url: site.toString(),
    telephone: company.phone,
    email: company.email,
    taxID: company.taxId,
    description: copy.home.seoDescription,
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'ул. Захарова, д. 50в, кв. 82',
      addressLocality: 'Минск',
      addressCountry: 'BY',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': schemaType,
    name: title,
    description,
    url: canonicalUrl.toString(),
    inLanguage: localeMeta[locale].htmlLang,
    about: { '@id': organizationId },
  },
  ...(!currentSlug ? [{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': new URL('/#website', site).toString(),
    name: company.brand,
    url: site.toString(),
  }] : []),
  ...(currentSlug && !noindex ? [{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: copy.common.home,
        item: new URL(localizePath(locale, ''), site).toString(),
      },
      ...breadcrumbParents.map((parent, index) => ({
        '@type': 'ListItem',
        position: index + 2,
        name: parent.label,
        item: new URL(localizePath(locale, parent.path), site).toString(),
      })),
      ...[{
            '@type': 'ListItem',
            position: breadcrumbParents.length + 2,
            name: title,
            item: canonicalUrl.toString(),
          }],
    ],
  }] : []),
  ...(additionalSchema ? [{ '@context': 'https://schema.org', ...additionalSchema }] : []),
];
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#002a55" />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
    <meta name="generator" content={Astro.generator} />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    {!noindex && locales.map((alternateLocale) => (
      <link
        rel="alternate"
        hreflang={localeMeta[alternateLocale].htmlLang}
        href={new URL(localizePath(alternateLocale, currentSlug), site)}
      />
    ))}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(localizePath('ru', currentSlug), site)} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="ESIpro" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={localeMeta[locale].ogLocale} />
    {!noindex && locales.filter((alternateLocale) => alternateLocale !== locale).map((alternateLocale) => <meta property="og:locale:alternate" content={localeMeta[alternateLocale].ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="96x96" />
    <link rel="sitemap" href="/sitemap.xml" />
    <title>{fullTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{locale === 'en' ? 'Skip to main content' : locale === 'by' ? 'Перайсці да зместу' : 'Перейти к содержимому'}</a>
    <Header locale={locale} currentSlug={noindex ? '' : currentSlug} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
