---
import { localizePath, messages, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
  title: string;
  intro: string;
  parent?: { label: string; path: string };
}

const { locale, title, intro, parent } = Astro.props;
const copy = messages[locale];
---

<section class="page-hero">
  <div class="container page-hero-grid">
    <div>
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={localizePath(locale)}>{copy.common.home}</a>
        <span aria-hidden="true">/</span>
        {parent && <><a href={localizePath(locale, parent.path)}>{parent.label}</a><span aria-hidden="true">/</span></>}
        <span aria-current="page">{title}</span>
      </nav>
      <h1>{title}</h1>
    </div>
    <p>{intro}</p>
  </div>
  <div class="page-hero-blueprint" aria-hidden="true"></div>
</section>
