---
import { localizePath, messages, type Locale } from '../data/i18n';
import { company } from '../data/company';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = messages[locale];
---

<footer class="site-footer">
  <div class="container footer-main">
    <div>
      <a class="footer-brand" href={localizePath(locale)} aria-label="ESIpro — home">
        <img src="/images/brand/logobottom.png" width="180" height="99" alt="ESIpro" />
      </a>
      <p>{copy.footer.text}</p>
    </div>
    <nav class="footer-links" aria-label="Footer">
      <a href={localizePath(locale, 'catalog')}>{copy.nav.catalog}</a>
      <a href={localizePath(locale, 'objects')}>{copy.nav.objects}</a>
      <a href={localizePath(locale, 'reviews')}>{copy.nav.reviews}</a>
      <a href={localizePath(locale, 'documents')}>{copy.common.download}</a>
      <a href={localizePath(locale, 'privacy')}>{copy.contacts.privacy}</a>
    </nav>
    <div class="footer-contacts">
      <a href={`tel:${company.phone}`}>{company.phoneDisplay}</a>
      <a href={`mailto:${company.email}`}>{company.email}</a>
      <address>{company.registeredAddress}</address>
      <span>{copy.company.taxId}: {company.taxId}</span>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} {company.legalName}</span>
    <span>{copy.footer.legal}</span>
  </div>
</footer>
