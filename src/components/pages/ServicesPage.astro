---
import ContactBand from '../ContactBand.astro';
import PageHero from '../PageHero.astro';
import { messages, type Locale } from '../../data/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = messages[locale];
---

<PageHero locale={locale} title={copy.services.title} intro={copy.services.intro} />
<section class="section">
  <ol class="container services-list">
    {copy.services.items.map(([title, text], index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><h2>{title}</h2><p>{text}</p></div></li>)}
  </ol>
</section>
<ContactBand locale={locale} />
