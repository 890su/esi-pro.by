---
import PageHero from '../PageHero.astro';
import ContactBand from '../ContactBand.astro';
import { analyticsAuthors, analyticsCopy, analyticsDocument, thermalScenarios } from '../../data/analytics';
import { localizePath, type Locale } from '../../data/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = analyticsCopy[locale];
const ids = ['configuration', 'insulation', 'heat-load', 'specifications', 'boiler-plant'];
const specs = [
  ['2', '1'],
  [`50 ${copy.volume}`, `100 ${copy.volume}`],
  [`41 ${copy.volume}`, `80 ${copy.volume}`],
  [`53 ${copy.volume}`, `115 ${copy.volume}`],
  [`6,73 × 7,24 × 5,6 ${copy.dimensions}`, `13,23 × 7,24 × 5,6 ${copy.dimensions}`],
  [`13,1 ${copy.electric}`, `26,2 ${copy.electric}`],
  [`185 ${copy.kw}`, `370 ${copy.kw}`],
  ['4', '8'],
  [copy.insulationSize, copy.insulationSize],
  ['AS-200', 'AS-200'],
];
---

<PageHero locale={locale} title={copy.articleTitle} intro={copy.articleDescription} parent={{ label: copy.title, path: 'analytics' }} />
<article class="section analytics-article">
  <div class="container analytics-article-grid">
    <aside class="analytics-sidebar">
      <nav class="article-toc" aria-label={copy.toc}>
        <p class="section-kicker">{copy.toc}</p>
        <ul>{copy.sections.map((title, index) => <li><a href={`#${ids[index]}`}>{title}</a></li>)}</ul>
        <a class="arrow-link" href="#source">{copy.source}<span aria-hidden="true">↓</span></a>
      </nav>
    </aside>
    <div class="article-body">
      <p class="article-scope">{copy.scope}</p>
      <p class="article-byline">{copy.authors}: {analyticsAuthors.join(', ')}.</p>
      <section id={ids[0]}>
        <h2>{copy.sections[0]}</h2>
        <p>{copy.overview}</p>
        <figure class="article-figure article-figure-chamber">
          <img src="/images/analytics/sk-chamber.webp" width="500" height="249" alt={copy.captions[1]} loading="lazy" />
          <figcaption>{copy.captions[1]}</figcaption>
        </figure>
      </section>
      <section id={ids[1]}>
        <h2>{copy.sections[1]}</h2>
        <p>{copy.insulation}</p>
        <figure class="article-figure">
          <a href="/images/analytics/drying-schedule.webp" target="_blank" rel="noopener">
            <img src="/images/analytics/drying-schedule.webp" width="1107" height="745" alt={copy.captions[0]} loading="lazy" />
          </a>
          <figcaption>{copy.captions[0]}</figcaption>
        </figure>
      </section>
      <section id={ids[2]}>
        <h2>{copy.sections[2]}</h2>
        <p>{copy.load}</p>
        <div class="table-scroll article-table-scroll" role="region" aria-label={copy.sections[2]} tabindex="0">
          <table class="article-table">
            <thead><tr><th scope="col">{copy.scenario}</th><th scope="col">{copy.polyurethane}</th><th scope="col">{copy.mineral}</th></tr></thead>
            <tbody>{thermalScenarios.map((values, index) => <tr><th scope="row">{copy.scenarios[index]}</th>{values.map((value) => <td>{value === null ? '—' : `${value} ${copy.kw}`}</td>)}</tr>)}</tbody>
          </table>
        </div>
        <p class="article-note">{copy.loadNote}</p>
      </section>
      <section id={ids[3]}>
        <h2>{copy.sections[3]}</h2>
        <div class="table-scroll article-table-scroll" role="region" aria-label={copy.specsTitle} tabindex="0">
          <table class="article-table">
            <caption>{copy.specsTitle}</caption>
            <thead><tr><th scope="col">{copy.parameter}</th><th scope="col">SK-136</th><th scope="col">SK-272</th></tr></thead>
            <tbody>{specs.map((values, index) => <tr><th scope="row">{copy.parameters[index]}</th>{values.map((value) => <td>{value}</td>)}</tr>)}</tbody>
          </table>
        </div>
        <p class="article-note">{copy.specNote}</p>
      </section>
      <section id={ids[4]}>
        <h2>{copy.sections[4]}</h2>
        <p>{copy.equipment}</p>
        <div class="article-diagrams">
          <figure class="article-figure"><img src="/images/analytics/kwh-boiler.webp" width="400" height="386" alt={copy.captions[2]} loading="lazy" /><figcaption>{copy.captions[2]}</figcaption></figure>
          <figure class="article-figure"><img src="/images/analytics/azsd-combustion.webp" width="798" height="676" alt={copy.captions[3]} loading="lazy" /><figcaption>{copy.captions[3]}</figcaption></figure>
        </div>
        <p>{copy.conclusion}</p>
      </section>
      <section class="article-source" id="source">
        <h2>{copy.source}</h2>
        <p>{copy.sourceText}</p>
        <a class="button button-primary" href={analyticsDocument} download>{copy.download}<span aria-hidden="true">↓</span></a>
        <p class="article-file-meta">{copy.sourceLabel}</p>
      </section>
      <nav class="article-related" aria-label={copy.related}>
        <h2>{copy.related}</h2>
        <a class="arrow-link" href={localizePath(locale, 'catalog/equipment/sk')}>{copy.chamber}<span aria-hidden="true">→</span></a>
        <a class="arrow-link" href={localizePath(locale, 'catalog/equipment/kwh-azsd')}>{copy.boiler}<span aria-hidden="true">→</span></a>
      </nav>
    </div>
  </div>
</article>
<ContactBand locale={locale} />
