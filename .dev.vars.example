# Copy this file to .dev.vars for local Cloudflare Pages preview only.
# Never commit real credentials.
# Native Cloudflare Email Sending uses the EMAIL binding from wrangler.jsonc.
# It requires the esi-pro.by sender domain and bula.esi@gmail.com recipient
# to be enabled and verified in Cloudflare Email Service.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional email delivery through Resend (https://resend.com/).
RESEND_API_KEY=
CONTACT_EMAIL=
CONTACT_FROM_EMAIL=
